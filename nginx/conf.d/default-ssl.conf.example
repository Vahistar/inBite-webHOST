server {
    listen 443 ssl;
    server_name example.com;

    ssl_certificate     /home/container/certbot/live/example.com/fullchain.pem;
    ssl_certificate_key /home/container/certbot/live/example.com/privkey.pem;
    ssl_protocols       TLSv1.2 TLSv1.3;

    root /home/container/www;
    index index.php index.html index.htm;

    location / {
        try_files $uri $uri/ /index.php?$query_string;
    }

    include /home/container/nginx/snippets/php-fpm.conf;
    include /home/container/nginx/snippets/security-deny.conf;
}

